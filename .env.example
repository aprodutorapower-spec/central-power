# Copie para .env.local e preencha (valores em Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
# Só no servidor. Cifra as chaves de API da Berry guardadas no banco.
# Gerar com: openssl rand -base64 32 (se trocar, as chaves precisam ser coladas de novo)
BERRY_SEGREDO=
# Só no servidor. Identifica o agendador que roda /api/cron (gerar com: openssl rand -hex 32)
CRON_SECRET=
# Segredo das rotinas agendadas do Claude: verba do Meta Ads (/api/cron/meta)
# e avisos no Asana (/api/cron/avisos)
META_ROTINA_SEGREDO=
# Chave de disparo da rotina do Meta Ads (botão "Atualizar pelo Meta Ads agora").
# Gerada em claude.ai/code/routines > rotina do Meta > Edit > Add another trigger > API.
META_ROTINA_TOKEN=
# Só no servidor. Identifica o robô de WhatsApp na porta de leitura /api/cron/agenda
# (gerar com: openssl rand -hex 32)
ROBO_SEGREDO=

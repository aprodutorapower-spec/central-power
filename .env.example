# Copie para .env.local e preencha (valores em Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
# Só no servidor. Cifra as chaves de API da Berry guardadas no banco.
# Gerar com: openssl rand -base64 32 (se trocar, as chaves precisam ser coladas de novo)
BERRY_SEGREDO=
